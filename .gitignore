# (they appear as ._.DS_Store, ._foo.py, ... next to the real file).
._*

# LaTeX build outputs (in docs/<species>/)
docs/**/*.aux
docs/**/*.log
docs/**/*.out
docs/**/*.toc
docs/**/*.bbl
docs/**/*.blg
docs/**/*.fdb_latexmk
docs/**/*.fls
docs/**/*.synctex.gz

# Local data caches — TUBA reads species data from paths configured by
# env vars (TUBA_MOUSE_REG_DIR, TUBA_HUMAN_REG_DIR, ...) and the data
# itself is never committed. The defaults below are the locations the
# code falls back to if env vars are unset.
.cache/
data/cache/
# Root-anchored staging dirs for raw scans (never committed; see
# src/tuba/data/sources.toml). Anchored with a leading slash so they only
# match the repo-root dirs, NOT the tracked src/tuba/data/ package.
/data/
/skull_sources/
# Per-species staging/build caches dropped at the repo root by the
# fetchers and species drivers. These are multi-GB: /saimiri alone is
# ~1.6 GB, so an unguarded `git add -A` would try to commit the scan
# data this repo exists to NOT ship.
/saimiri/
/mouse/
/rat/
/macaque/
/human/
